# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio: .gitignore ya lo bloquea.

# --- Publicas: se incluyen en el paquete del navegador ---
# URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anonima. Es publica por diseno y depende de RLS para ser segura.
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplazar-con-la-clave-anonima

# URL base para construir los enlaces publicos de reporte.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Privadas: solo servidor. Jamas usar el prefijo NEXT_PUBLIC_ ---
# Clave service_role: omite RLS por completo. Solo en secretos del servidor.
SUPABASE_SERVICE_ROLE_KEY=reemplazar-solo-en-el-servidor
